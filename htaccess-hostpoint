# Wird auf Hostpoint als .htaccess ausgeliefert (siehe .github/workflows).
# Im Repository ohne Punkt, damit man die Datei sieht.

Options -Indexes

# Abgleichsdatei des Uploads: listet alle Dateien, geht Besucher nichts an.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Zugang zum Kalender, nur fuer termine.php. Lieferte ohnehin nichts aus,
# sicherheitshalber trotzdem gesperrt.
<Files "kalender-zugang.php">
  Require all denied
</Files>

# Immer https und immer www.formateins.ch. Faengt auch die Adresse ohne www
# und spaeter format1.ch ab, wenn sie aufs selbe Hosting zeigt.
# Setzt ein aktives SSL-Zertifikat bei Hostpoint voraus.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.formateins\.ch$ [NC]
RewriteRule ^ https://www.formateins.ch%{REQUEST_URI} [R=301,L]

# Adressen ohne .html: /gespraech statt /gespraech.html. Wer die alte Form
# aufruft (Lesezeichen, Absage-Links in schon verschickten Mails), wird
# dauerhaft umgeleitet, die Angaben nach dem ? bleiben erhalten. THE_REQUEST
# ist die Anfrage des Browsers, nicht das Ergebnis der Regel darunter, darum
# entsteht keine Schleife.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
# Schraegstrich am Ende weg, ausser bei echten Ordnern.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]
# Die kurze Adresse intern wieder auf die Datei legen. Das Muster endet nie auf
# /, sonst haengt Apache .html an "gespraech/" und dreht sich im Kreis.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*[^/])$ $1.html [L]

# Seiten, Stil und Skript immer frisch nachfragen, damit Aenderungen sofort
# sichtbar sind. Schriften aendern sich nie, Bilder selten (die Werkbank
# zaehlt bei neuen Aufnahmen ?v= hoch).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
