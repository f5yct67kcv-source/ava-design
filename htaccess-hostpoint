# Wird auf Hostpoint als .htaccess ausgeliefert (siehe .github/workflows).
# Im Repository ohne Punkt, damit man die Datei sieht.

Options -Indexes

# Abgleichsdatei des Uploads: listet alle Dateien, geht Besucher nichts an.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Zugang zum Kalender, nur fuer termine.php. Lieferte ohnehin nichts aus,
# sicherheitshalber trotzdem gesperrt.
<Files "kalender-zugang.php">
  Require all denied
</Files>

# Immer https und immer www.formateins.ch. Faengt auch die Adresse ohne www
# und spaeter format1.ch ab, wenn sie aufs selbe Hosting zeigt.
# Setzt ein aktives SSL-Zertifikat bei Hostpoint voraus.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.formateins\.ch$ [NC]
RewriteRule ^ https://www.formateins.ch%{REQUEST_URI} [R=301,L]

# Seiten, Stil und Skript immer frisch nachfragen, damit Aenderungen sofort
# sichtbar sind. Schriften aendern sich nie, Bilder selten (die Werkbank
# zaehlt bei neuen Aufnahmen ?v= hoch).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
